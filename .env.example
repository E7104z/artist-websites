# Which artist this deployment serves (folder name under src/artists). One Vercel
# project per artist, each with its own VITE_ARTIST_SLUG and domain.
VITE_ARTIST_SLUG=tracy-smith

# AgencyOS booking-inquiry endpoint (HTTPS Cloud Function in artist-app).
# Local emulator:  http://127.0.0.1:5001/agencyos-dev/us-central1/submitBookingInquiry
VITE_BOOKING_ENDPOINT=http://127.0.0.1:5001/agencyos-dev/us-central1/submitBookingInquiry

# Cloudflare Turnstile PUBLIC site key. Required in production (the backend
# rejects submissions without a valid token). Leave empty only for local/emulator work.
VITE_TURNSTILE_SITE_KEY=

# Set to "true" on production builds: the build fails while any content item in
# src/artists/<slug>/approvals.json is still unapproved.
VITE_REQUIRE_APPROVALS=false
